#
# xactor, a header-only, deterministic actor system. A program uses it
# through /webcpp/xactor//xactor, which adds its headers, Boost's and
# webcpp's configuration.

project /webcpp/xactor ;

alias xactor : : : : <include>include <library>/boost//headers <library>/webcpp/config//config ;
